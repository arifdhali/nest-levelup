model User {
    id              Int      @id @default(autoincrement())
    name            String
    email           String   @unique
    password        String
    role            UserRole @default(user)
    status          Boolean  @default(true)
    user_permission Json     @default("[]")
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    order        Order[]
    userProfiles UserProfile?
}

enum UserRole {
    user
    admin
    superAdmin
}
