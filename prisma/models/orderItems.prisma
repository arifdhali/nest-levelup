model OrderItems {
    id Int @id @default(autoincrement())
    orderId Int
    productId Int 
    unit_price Decimal     @default(0.00) @db.Decimal(10, 2)


    orderFk Order @relation(fields:[orderId],references:[id])
    productFk Product @relation(fields:[productId],references:[id])

    @@unique([orderId,productId])

}


